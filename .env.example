DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticketdb
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
REDIS_URL=redis://localhost:6379/0

# --- optional: really send sign-in codes (see README, "Send real sign-in codes") ---
# OTP_DEV_MODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
# OTP_SMS_PROVIDER=twilio        # or msg91
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# --- optional: real payments in TEST MODE with Razorpay (free test keys, no real money) ---
# See README "Pay with Razorpay (test mode)". Without these the fake bank is used.
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=       # the secret you type when adding the webhook in the Razorpay dashboard
# --- optional: AI assistant ---
# GEMINI_API_KEY=

# --- public server checklist (ENVIRONMENT=production refuses to start if these are unsafe) ---
# ENVIRONMENT=production
# JWT_SECRET=<long random string>
# PAYMENT_WEBHOOK_SECRET=<long random string>
# OTP_DEV_MODE=false
# GATEWAY_ALLOW_TEST_METHODS=false
# PUBLIC_BASE_URL=https://your-website.example.com   # where the QR code on a ticket points
# CORS_ORIGINS=https://your-website.example.com
# CORS_ORIGIN_REGEX=
# MAX_SESSION_DAYS=90
# ADMIN_PASSWORD=<strong password, used by the seed scripts>
